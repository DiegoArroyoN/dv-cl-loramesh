+bool
+LoraChannel::GetLatentSignalSf(uint64_t signalId, uint8_t* sfOut) const
+{
+    PurgeLatentSignals(Simulator::Now());
+    auto it = m_latentSignals.find(signalId);
+    if (it == m_latentSignals.end())
+    {
+        return false;
+    }
+    if (sfOut)
+    {
+        *sfOut = it->second.sf;
+    }
+    return true;
+}
+
+uint64_t
+LoraChannel::RegisterLatentSignal(uint8_t sf, Time expiresAt) const
+{
+    const uint64_t signalId = m_nextSignalId++;
+    LatentSignalInfo info;
+    info.sf = sf;
+    info.expiresAt = expiresAt;
+    m_latentSignals.emplace(signalId, info);
+    return signalId;
+}
+
+void
+LoraChannel::PurgeLatentSignals(Time now) const
+{
+    if (m_latentSignals.empty())
+    {
+        return;
+    }
+    for (auto it = m_latentSignals.begin(); it != m_latentSignals.end();)
+    {
+        if (it->second.expiresAt <= now)
+        {
+            it = m_latentSignals.erase(it);
+        }
+        else
+        {
+            ++it;
+        }
+    }
+}
