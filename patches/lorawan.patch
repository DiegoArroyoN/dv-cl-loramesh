+double
+Percentile95Double(std::vector<double> values)
+{
+    if (values.empty())
+    {
+        return 0.0;
+    }
+    std::sort(values.begin(), values.end());
+    const std::size_t idx = static_cast<std::size_t>(std::ceil(0.95 * values.size())) - 1;
+    return values[std::min(idx, values.size() - 1)];
